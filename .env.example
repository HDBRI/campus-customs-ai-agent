# Copy this file to .env (in HW3/ or the repository root) and fill in your own values.
# Never commit or share the real .env.

# Portkey gateway key used for all OpenAI calls
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: model and gateway settings (defaults shown)
AI_MODEL=gpt-5.6-luna
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai
